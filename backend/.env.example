# =============================================================================
# Nexora University – UniSphere AI Backend Environment Variables
# Copy this file to .env and replace placeholder values when ready.
# =============================================================================

# --- Application ---
APP_NAME=Nexora UniSphere AI
APP_VERSION=1.0.0
DEBUG=true
ENVIRONMENT=development
API_PREFIX=/api/v1
CORS_ORIGINS=http://localhost:3000

# --- Supabase (PostgreSQL + Auth + Storage) ---
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_KEY=your-supabase-service-role-key

# --- Pinecone (Vector Database) ---
PINECONE_API_KEY=your-pinecone-api-key
PINECONE_INDEX_NAME=nexora-university
PINECONE_ENVIRONMENT=us-east-1

# --- Groq (Llama 3.3 70B Instruct) ---
GROQ_API_KEY=your-groq-api-key
GROQ_MODEL=llama-3.3-70b-versatile

# --- Embeddings (BAAI/bge-large-en-v1.5) ---
EMBEDDING_MODEL=BAAI/bge-large-en-v1.5
EMBEDDING_DIMENSION=1024

# --- Knowledge Base ---
KNOWLEDGE_BASE_PATH=../knowledge_base
