# =============================================================================
# Nexora University – UniSphere AI Production Backend Environment Variables
# =============================================================================

# --- Application ---
APP_NAME=Nexora UniSphere AI
APP_VERSION=1.0.0
DEBUG=false
ENVIRONMENT=production
API_PREFIX=/api/v1
CORS_ORIGINS=https://unisphere.nexorauniversity.edu,https://admin.nexorauniversity.edu

# --- Supabase (PostgreSQL + Auth + Storage) ---
SUPABASE_URL=https://<your-supabase-project-id>.supabase.co
SUPABASE_ANON_KEY=<your-production-supabase-anon-key>
SUPABASE_SERVICE_KEY=<your-production-supabase-service-role-key>

# --- Pinecone (Vector Database) ---
PINECONE_API_KEY=<your-production-pinecone-api-key>
PINECONE_INDEX_NAME=nexora-university
PINECONE_ENVIRONMENT=us-east-1
PINECONE_CLOUD=AWS

# --- Groq (Llama 3.3 70B Instruct) ---
GROQ_API_KEY=<your-production-groq-api-key>
GROQ_MODEL=llama-3.3-70b-versatile

# --- Embeddings (BAAI/bge-large-en-v1.5) ---
EMBEDDING_MODEL=BAAI/bge-large-en-v1.5
EMBEDDING_DIMENSION=1024

# --- Knowledge Base ---
KNOWLEDGE_BASE_PATH=./knowledge_base
